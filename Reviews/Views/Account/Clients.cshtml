@model IEnumerable<Reviews.Models.Message>
@{
    ViewData["Title"] = "Відгуки";
    Layout = null;
}
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - La Pergola </title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container">
                <a style="color:#DBD6D2; font-family:Georgia, serif; font-size: 20px; text-decoration: none;" asp-area="" asp-controller="Home" asp-action="Index">La Pergola</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarTogglerDemo03" aria-controls="navbarTogglerDemo03" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">

                    <li class="nav-item">
                        <span class="user-name">
                            @Context.Session.GetString("FirstName") @Context.Session.GetString("LastName")
                        </span>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Logout">Вийти</a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="full-width-block">
        <div class="text-side">
            <h1>La Pergola</h1>
            <p>Місце, про яке хочеться розповісти.</p>
        </div>

        <div class="image-side">
            <img src="/picture/main.jpg" alt="image">
        </div>
    </div>
    <div class="container">
        <main role="main" class="pb-3">
<div class="d-flex justify-content-between align-items-center mb-3">

    <a asp-controller="Account" asp-action="Create" class="btn btn-success shadow-sm">+ Додати відгук</a>
</div>

<div class="reviews">

    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card shadow-sm border-0">
                <div class="card-body d-flex flex-column">

                    <div class="review-header">
                        <h4>@Html.DisplayFor(modelItem => item.User!.Login)</h4>
                        <span>@Html.DisplayFor(modelItem => item.MessageDate)</span>
                    </div>

                    <hr />
                    <p class="align-middle">@Html.DisplayFor(modelItem => item.Comment)</p>
                    @if (!string.IsNullOrEmpty(item.Foto))
                    {
                        <img class="foto" src="@item.Foto" alt="Фото відгуку" />
                    }

                            
                </div>
            </div>
        </div>
    }
</div>

        </main>
    </div>
    <footer>
        <div class="container text-right footer-text">
            &copy; @DateTime.Now.Year - Відгуки.
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

   
 
