@model Reviews.Models.Message
@{
    ViewData["Title"] = "Додати відгук";
}

<h2 class="create-title">Додати новий відгук</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form asp-action="Create" method="post" enctype="multipart/form-data" class="creare-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Comment" class="form-label fw-bold"></label>
                        <textarea asp-for="Comment" class="form-control" placeholder="Введіть відгук"></textarea>
                        <span asp-validation-for="Comment" class="text-danger"></span>
                    </div>


                    <div class="mb-3">
                        <label asp-for="Foto" class="form-label fw-bold"></label>
                        <input name="posterFile" class="form-control" type="file" accept="image/png, image/jpeg" placeholder="Завантажте фото" />
                        <span asp-validation-for="Foto" class="text-danger"></span>
                    </div>


                    <div class="d-flex justify-content-between">
                        <a asp-action="Clients" class="btn btn-light border">Повернутися</a>
                        <input type="submit" value="Зберегти" class="btn btn-primary px-4 sav-btn" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}